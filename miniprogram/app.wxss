page {
  min-height: 100%;
  background: #f7f9fc;
  color: #0b1f44;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}


button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* 时段配色变量的默认值（中午时段）。各页在根节点用 time-theme.pageStyle 覆盖。 */
page {
  --text: #063884; --sub: #586b80; --faint: #8799ad; --line: rgba(6,56,132,.1);
  --accent: #176be8; --accent-soft: rgba(23,107,232,.14); --on-accent: #ffffff; --btn: #176be8; --on-btn: #ffffff;
  --card: rgba(255,255,255,.82); --nav: #eef6ff;
  --field: #ffffff; --field-line: rgba(6,56,132,.2); --fill: rgba(6,56,132,.05); --sheet: #ffffff;

}
.brand-logo-light { filter: brightness(0) invert(1); }
.page { --chip-bg: var(--card); --chip-line: var(--line); --chip-text: var(--text); }
