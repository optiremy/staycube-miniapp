@import "../common.wxss";

.today { display:flex; align-items:center; margin:32rpx 4rpx 8rpx; font-size:28rpx; color:var(--sub); }
.today-n { margin:0 4rpx; font-size:36rpx; font-weight:700; color:var(--text); }
.today-link { margin-left:auto; color:var(--accent); }

.cat { margin-top:28rpx; border:1rpx solid var(--line); border-radius:24rpx; background:var(--field); overflow:hidden; }
.cat-head { display:flex; align-items:center; padding:24rpx 28rpx; background:var(--accent-soft); color:var(--accent); }
.cat-name { font-size:38rpx; font-weight:700; letter-spacing:2rpx; }
.cat-count { margin-left:auto; font-size:48rpx; font-weight:700; line-height:1; }

.row { display:flex; align-items:center; margin:0 28rpx; padding:22rpx 0; border-top:1rpx solid var(--line); }
.cat-head + .row { border-top:0; }
.row-main { flex:1; min-width:0; }
.row-title { display:flex; align-items:center; gap:16rpx; }
.row-room { font-size:30rpx; font-weight:400; color:var(--text); }
.row-note { display:block; margin-top:6rpx; font-size:24rpx; color:var(--red); }
.row-arrow { margin-left:16rpx; font-size:36rpx; color:var(--faint); }
.row-other { display:block; margin-top:6rpx; font-size:24rpx; color:var(--sub); }
.state { display:flex; align-items:center; margin-top:28rpx; padding:20rpx 24rpx; border-radius:16rpx; background:var(--amber-soft); color:var(--amber); font-size:26rpx; }
.state-link { margin-left:auto; color:var(--accent); font-weight:600; white-space:nowrap; }
