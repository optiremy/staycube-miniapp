@import "../common.wxss";
.mine-list { margin-top:36rpx; }
.mine-source { display:block; margin-bottom:12rpx; font-size:22rpx; color:var(--faint); }
.mine-actions { display:flex; justify-content:flex-end; gap:40rpx; margin-top:20rpx; padding-top:20rpx; border-top:1rpx solid var(--line); }
