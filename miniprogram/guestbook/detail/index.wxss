@import "../common.wxss";
.big { padding:48rpx 40rpx 32rpx; font-size:34rpx; line-height:1.85; }
.reactions { display:grid; grid-template-columns:repeat(3, 1fr); gap:16rpx; margin-top:32rpx; }
.reaction { display:flex; flex-direction:column; align-items:center; gap:8rpx; padding:24rpx 0; border-radius:28rpx; border:1rpx solid var(--line); background:var(--card); }
.reaction-on { border-color:var(--accent); box-shadow:inset 0 0 32rpx var(--accent-soft); }
.reaction-off { opacity:.75; }
.reaction-label { font-size:26rpx; }
.reaction-count { font-family:"SF Mono", Menlo, monospace; font-size:22rpx; color:var(--faint); }
.reaction-on .reaction-count { color:var(--accent); }
.lock { margin-top:40rpx; padding:36rpx; border-radius:28rpx; border:1rpx dashed var(--line); text-align:center; }
.lock-title { font-size:28rpx; font-weight:600; }
.share { margin-top:36rpx; height:92rpx; line-height:92rpx; border-radius:46rpx; border:1rpx solid var(--line); background:var(--card); color:var(--text); font-size:30rpx; }
.share::after { border:0; }
