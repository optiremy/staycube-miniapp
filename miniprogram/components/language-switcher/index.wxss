.lang-chip { flex:none; width:auto !important; display:flex; align-items:center; gap:10rpx; height:64rpx; margin:0; padding:0 24rpx; border:1rpx solid #d7e2ec; border-radius:32rpx; background:#fff; color:#0b1f44; font-size:25rpx; line-height:64rpx; font-weight:600; }
.lang-chip::after { border:0; }
.lang-chip.is-locked { color:#91a1b3; }
.lang-chip-arrow { color:#176be8; font-size:18rpx; }
.lang-chip.is-locked .lang-chip-arrow { color:#b7c5d4; }

.lang-mask { position:fixed; z-index:30; inset:0; display:flex; align-items:flex-end; background:rgba(11,31,68,.42); }
.lang-sheet { width:100%; box-sizing:border-box; padding:36rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; }
.lang-sheet-head { display:flex; align-items:center; justify-content:space-between; }
.lang-sheet-title { color:#0b1f44; font-size:34rpx; line-height:1.35; font-weight:700; }
.lang-sheet-close { width:64rpx; height:64rpx; margin:0 -10rpx 0 0; padding:0; background:transparent; color:#718198; font-size:48rpx; line-height:64rpx; }
.lang-sheet-close::after { border:0; }
.lang-sheet-hint { display:block; margin:10rpx 0 24rpx; color:#586b80; font-size:24rpx; line-height:1.55; }
.lang-row { width:100% !important; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; height:88rpx; margin:0 0 14rpx; padding:0 24rpx; border:1rpx solid #d7e2ec; border-radius:16rpx; background:#fff; color:#0b1f44; font-size:28rpx; line-height:88rpx; font-weight:600; text-align:left; }
.lang-row::after { border:0; }
.lang-row.is-current { border-color:#176be8; background:#f2f7ff; color:#063884; }
.lang-row-tick { color:#176be8; }
.lang-chip-globe { width:32rpx; height:32rpx; flex:none; }
.lang-chip.is-locked .lang-chip-globe { opacity:.45; }
