.luggage-page { min-height:100vh; box-sizing:border-box; padding:28rpx 40rpx calc(56rpx + env(safe-area-inset-bottom)); display:flex; flex-direction:column; }
.luggage-page .page-head { height:56rpx; flex:none; display:flex; align-items:center; gap:14rpx; }
.luggage-page .brand-logo { width:106rpx; height:42rpx; }
.luggage-page .brand-divider { width:1rpx; height:30rpx; margin:0 2rpx; background:#d7e2ec; }
.luggage-page .brand-product { margin-right:auto; color:#0b1f44; font-size:27rpx; font-weight:700; }
.luggage-page .screen { flex:1; min-height:0; display:flex; flex-direction:column; padding-top:38rpx; }
.luggage-language-screen { padding-top:90rpx !important; }
.luggage-page .hero-mark { box-sizing:border-box; width:100%; height:210rpx; display:flex; align-items:center; gap:28rpx; margin-bottom:10rpx; }
.luggage-page .hero-mark-icon { width:90rpx; height:90rpx; flex:none; border-radius:26rpx; background:#e9f1ff; display:flex; align-items:center; justify-content:center; }
.luggage-page .hero-mark-inner { position:relative; width:36rpx; height:36rpx; border:7rpx solid #176be8; border-radius:11rpx; }
.luggage-page .hero-mark-inner::after { content:''; position:absolute; width:12rpx; height:12rpx; background:#176be8; border-radius:4rpx; top:5rpx; left:5rpx; }
.luggage-page .hero-mark-copy { display:flex; flex-direction:column; gap:8rpx; }
.luggage-page .hero-mark-title { color:#0b1f44; font-size:30rpx; line-height:1.35; font-weight:700; }
.luggage-page .hero-mark-en { color:#77889b; font-size:18rpx; line-height:1.4; font-weight:650; letter-spacing:1rpx; }
.luggage-page .hero-title { display:block; margin-top:18rpx; color:#0b1f44; font-size:42rpx; line-height:1.28; font-weight:700; letter-spacing:-1.5rpx; }
.luggage-page .hero-title-en { display:block; margin-top:8rpx; color:#77889b; font-size:19rpx; line-height:1.4; font-weight:650; letter-spacing:1.2rpx; }
.luggage-page .body-copy { display:block; margin-top:16rpx; color:#586b80; font-size:26rpx; line-height:1.65; }
.luggage-page .language-grid { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:42rpx; }
.luggage-page .language-option { box-sizing:border-box; flex:0 0 calc((100% - 16rpx)/2); width:calc((100% - 16rpx)/2); min-width:0; height:92rpx; margin:0; padding:0 24rpx; border:1rpx solid #d7e2ec; border-radius:14rpx; background:#fff; color:#0b1f44; text-align:left; display:flex; align-items:center; justify-content:space-between; font-size:27rpx; font-weight:600; }
.luggage-page .language-option::after,.luggage-page .primary-button::after,.luggage-page .secondary-button::after,.luggage-page .text-button::after,.luggage-page .photo-choose-button::after,.luggage-page .photo-remove::after { border:0; }
.luggage-page .option-arrow { color:#176be8; font-size:38rpx; font-weight:400; }
.luggage-page .language-label { flex:1; min-width:0; margin-right:16rpx; white-space:normal; overflow-wrap:anywhere; line-height:1.25; }
.luggage-page .page-foot { margin-top:auto; padding-top:30rpx; color:#91a1b3; text-align:center; font-size:22rpx; }
.luggage-page .home-indicator { position:fixed; z-index:4; left:50%; bottom:calc(12rpx + env(safe-area-inset-bottom)); width:240rpx; height:10rpx; margin-left:-120rpx; background:#111; border-radius:12rpx; }
.luggage-page .section-index { display:block; color:#176be8; font-size:21rpx; font-weight:700; letter-spacing:2rpx; }
.luggage-page .screen-title { display:block; margin-top:12rpx; color:#0b1f44; font-size:38rpx; line-height:1.4; font-weight:700; }
.luggage-page .form-intro { margin-top:10rpx; }
.luggage-form-screen { padding-top:48rpx !important; padding-bottom:20rpx; }
.form-section { margin-top:26rpx; padding-top:22rpx; border-top:1rpx solid #dce5ee; }
.form-section-title { display:block; color:#0b1f44; font-size:27rpx; line-height:1.5; font-weight:700; }
.luggage-input { box-sizing:border-box; width:100%; height:92rpx; margin-top:14rpx; padding:0 22rpx; border:1rpx solid #c9d5e1; border-radius:12rpx; background:#fff; color:#0b1f44; font-size:30rpx; }
.contact-method-block { margin-top:20rpx !important; }
.luggage-page .field-block { display:flex; flex-direction:column; gap:12rpx; margin-top:20rpx; }
.luggage-page .field-label { color:#42566e; font-size:24rpx; font-weight:600; }
.contact-options { display:flex; gap:28rpx; align-items:center; min-height:54rpx; }
.contact-option { display:flex; align-items:center; gap:8rpx; color:#42566e; font-size:25rpx; }
.contact-option radio { transform:scale(.9); }
.date-time-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.8fr); gap:16rpx; }
.picker-value { box-sizing:border-box; min-height:88rpx; border:1rpx solid #c9d5e1; border-radius:12rpx; background:#fff; padding:24rpx 20rpx; color:#0b1f44; font-size:28rpx; }
.picker-value { display:flex; align-items:center; justify-content:space-between; }
.picker-arrow { color:#71849a; font-size:28rpx; }
.field-hint { display:block; margin-top:12rpx; color:#71849a; font-size:22rpx; line-height:1.6; }
.notices-section checkbox-group { display:flex; flex-direction:column; gap:18rpx; margin-top:12rpx; }
.notice-row { display:flex; align-items:flex-start; gap:10rpx; color:#485c70; font-size:24rpx; line-height:1.6; }
.notice-row checkbox { flex:none; margin-top:2rpx; transform:scale(.9); transform-origin:left top; }
.photo-section { margin-bottom:4rpx; }
.photo-actions { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; margin-top:14rpx; }
.photo-choose-button { box-sizing:border-box; width:100%; min-height:92rpx; margin:0; padding:10rpx; border:1rpx dashed #a9bed3; border-radius:14rpx; background:#fff; color:#176be8; font-size:24rpx; font-weight:650; display:flex; align-items:center; justify-content:center; text-align:center; }
.photo-selected { display:flex; align-items:center; gap:16rpx; margin-top:14rpx; padding:12rpx; border:1rpx solid #d7e2ec; border-radius:14rpx; background:#fff; }
.photo-thumbnail { width:92rpx; height:92rpx; border-radius:10rpx; background:#edf2f7; }
.photo-file-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; color:#42566e; font-size:23rpx; }
.photo-file-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#8092a5; font-size:20rpx; }
.photo-remove { margin:0; padding:8rpx 10rpx; background:transparent; color:#b44545; font-size:22rpx; }
.privacy-check { display:block; margin-top:22rpx; }
.luggage-page .inline-error { display:block; margin-top:18rpx; color:#b42318; font-size:24rpx; line-height:1.55; }
.luggage-page .form-actions { display:flex; gap:14rpx; margin-top:24rpx; padding-bottom:10rpx; }
.luggage-form-screen { min-height:0; overflow-y:auto; }
.form-step { flex:1; min-height:0; overflow-y:auto; }
.first-form-section { margin-top:20rpx; }
.fee-section checkbox-group { margin-top:14rpx; }
.luggage-page .form-action { position:relative; box-sizing:border-box; flex:1; min-width:0; min-height:90rpx; margin:0; border-radius:12rpx; font-size:26rpx; font-weight:650; display:flex; align-items:center; justify-content:center; text-align:center; }
.luggage-page .secondary-button { border:1rpx solid #c9d5e1; background:#fff; color:#29425d; }
.luggage-page .primary-button { border:1rpx solid #176be8; background:#176be8; color:#fff; }
.luggage-page .button-arrow { position:absolute; right:24rpx; font-size:34rpx; line-height:1; flex:none; }
.luggage-page .button-label { display:block; box-sizing:border-box; width:100%; min-width:0; padding:0 48rpx; white-space:normal; overflow-wrap:anywhere; line-height:1.3; text-align:center; }
.luggage-page .text-button { margin-top:10rpx; background:transparent; color:#176be8; font-size:24rpx; }
.retry-button { align-self:flex-start; }
.luggage-success-screen { box-sizing:border-box; flex:1; min-height:0; justify-content:center; align-items:center; text-align:center; padding:0 10rpx !important; }
.success-symbol { width:112rpx; height:112rpx; margin-bottom:30rpx; border-radius:50%; background:#e6f4ec; display:flex; align-items:center; justify-content:center; }
.success-check { width:28rpx; height:50rpx; margin-top:-10rpx; border-right:10rpx solid #23734f; border-bottom:10rpx solid #23734f; transform:rotate(42deg); }
.success-pill { display:flex; align-items:center; gap:12rpx; padding:14rpx 20rpx; border-radius:30rpx; background:#e6f4ec; color:#23734f; font-size:24rpx; }
.success-dot { width:12rpx; height:12rpx; border-radius:50%; background:#2d9a68; }
.success-copy { max-width:100%; margin:26rpx auto 0; color:#3d5671; font-size:28rpx; line-height:1.7; text-align:center; }
.keep-together { white-space:nowrap; }
.success-divider { width:92rpx; height:2rpx; flex:none; margin:30rpx auto 0; background:#d7e2ec; }
.success-back { min-height:86rpx; margin-top:34rpx; padding:0 28rpx; border-radius:12rpx; font-size:25rpx; display:flex; align-items:center; justify-content:center; text-align:center; }
.is-button-disabled { opacity:.55; }
.photo-processing-canvas { position:fixed; left:-10000px; top:-10000px; width:1px; height:1px; opacity:0; pointer-events:none; }
.phone-row { display:flex; gap:14rpx; align-items:center; }
.country-code { box-sizing:border-box; display:flex; align-items:center; gap:10rpx; height:92rpx; padding:0 22rpx; border:1rpx solid #c9d5e1; border-radius:12rpx; background:#fff; color:#0b1f44; font-size:28rpx; font-weight:600; }
.country-code-arrow { color:#176be8; font-size:18rpx; }
.phone-number-input { flex:1; min-width:0; margin-top:0 !important; }
.luggage-page .field-hint { color:#7a8ca0; font-size:22rpx; line-height:1.5; }
