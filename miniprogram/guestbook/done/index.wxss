@import "../common.wxss";
.done { display:flex; flex-direction:column; align-items:center; text-align:center; padding-top:72rpx; position:relative; }
.fly { width:460rpx; text-align:left; animation:settle 1.6s .9s cubic-bezier(.6,0,.2,1) both; }
.fly .note { margin:0; }
.ghosts { position:absolute; top:372rpx; left:50%; margin-left:-304rpx; display:grid; grid-template-columns:repeat(3, 192rpx); gap:16rpx; animation:fadein .6s 1.6s both; }
.ghosts view { height:100rpx; border-radius:24rpx; border:1rpx solid var(--line); background:var(--card); }
.ghosts .slot { background:none; border-color:transparent; }
.after { margin-top:300rpx; animation:fadein .8s 2.4s both; }
.done-title { display:block; font-size:44rpx; font-weight:600; }
.done-back { display:inline-block; margin-top:48rpx; font-size:28rpx; color:var(--accent); }
@keyframes settle { 0% { transform:none; } 35% { transform:translateY(-20rpx) scale(1.02); } 100% { transform:translateY(170rpx) scale(.42); } }
@keyframes fadein { from { opacity:0; transform:translateY(16rpx); } }
