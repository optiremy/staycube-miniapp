@import "../common.wxss";
.done { display:flex; flex-direction:column; align-items:center; text-align:center; }
/* 卡片落进第一行中间的空位：空位中心在舞台内 (304rpx, 50rpx)，卡片以中心对齐后缩放 */
.stage { position:relative; width:608rpx; height:216rpx; margin-top:420rpx; }
.ghosts { position:absolute; top:0; left:0; display:grid; grid-template-columns:repeat(3, 192rpx); gap:16rpx; animation:fadein .6s 1.6s both; }
.ghosts view { height:100rpx; border-radius:24rpx; border:1rpx solid var(--line); background:var(--card); }
.ghosts .slot { box-sizing:border-box; padding:14rpx 16rpx; overflow:hidden; text-align:left; animation:land .4s 2.4s both; }
.slot-text { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; font-size:20rpx; line-height:1.45; color:var(--text); }
@keyframes land { from { opacity:0; } to { opacity:1; } }
.fly { position:absolute; z-index:1; left:304rpx; top:50rpx; width:460rpx; text-align:left; transform:translate(-50%, -50%) translateY(-300rpx); animation:settle 1.6s .9s cubic-bezier(.6,0,.2,1) both; }
.fly .note { margin:0; }
.after { margin-top:72rpx; animation:fadein .8s 2.4s both; }
.done-title { display:block; font-size:44rpx; font-weight:600; }
.done-back { position:fixed; left:0; right:0; bottom:calc(120rpx + env(safe-area-inset-bottom)); font-size:28rpx; color:var(--accent); animation:fadein .8s 2.4s both; }
@keyframes settle {
  0% { transform:translate(-50%, -50%) translateY(-300rpx); }
  35% { transform:translate(-50%, -50%) translateY(-320rpx) scale(1.02); }
  90% { transform:translate(-50%, -50%) scale(.42); opacity:1; }
  100% { transform:translate(-50%, -50%) scale(.42); opacity:0; }
}
@keyframes fadein { from { opacity:0; transform:translateY(16rpx); } }
