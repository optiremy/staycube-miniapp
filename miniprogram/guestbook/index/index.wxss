@import "../common.wxss";
.gb-root { position:fixed; inset:0; overflow:hidden; font-family:-apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.area { width:100vw; height:100vh; }
.grid { display:grid; gap:24rpx; padding:24rpx 24rpx 220rpx; }
.tile { position:relative; width:300rpx; height:300rpx; box-sizing:border-box; border-radius:36rpx; border:1rpx solid transparent; overflow:hidden; }
.tile-img { position:absolute; inset:0; width:100%; height:100%; }
/* 文字放不下时底部渐隐 */
.tile-text { display:block; height:100%; padding:28rpx 26rpx 0; box-sizing:border-box; font-size:27rpx; line-height:1.6; color:var(--text);
  -webkit-mask-image:linear-gradient(180deg, #000 62%, transparent 92%); mask-image:linear-gradient(180deg, #000 62%, transparent 92%); }
.timeline { position:absolute; inset:0; height:100vh; box-sizing:border-box; }
.entries { position:relative; padding:32rpx 40rpx 260rpx 76rpx; }
.entries::before { content:''; position:absolute; left:48rpx; top:44rpx; bottom:260rpx; width:1rpx; background:var(--line); }
.entry { position:relative; margin-bottom:40rpx; }
.entry-dot { position:absolute; left:-37rpx; top:10rpx; width:18rpx; height:18rpx; border-radius:50%; }
.entry-when { display:flex; align-items:center; font-size:24rpx; color:var(--sub); }
.entry-date { font-weight:600; color:var(--text); }
.entry-mine { margin-left:12rpx; padding:2rpx 12rpx; border-radius:16rpx; background:var(--accent-soft); color:var(--accent); font-size:20rpx; }
.entry-by { margin-left:auto; }
.entry-box { margin-top:16rpx; padding:28rpx; border-radius:28rpx; border:1rpx solid var(--line); background:var(--card); font-size:28rpx; line-height:1.75; }
.entry-pics { display:flex; gap:12rpx; margin-top:20rpx; }
.entry-pic { flex:1; height:200rpx; border-radius:16rpx; }
/* 底部功能栏 */
.dock { position:fixed; left:50%; transform:translateX(-50%); bottom:calc(44rpx + env(safe-area-inset-bottom)); height:132rpx; padding:0 16rpx; display:flex; align-items:center; justify-content:center;
  border-radius:44rpx; background:rgba(12,20,38,.86); border:1rpx solid rgba(124,196,255,.22); box-shadow:0 20rpx 60rpx -20rpx rgba(0,0,0,.6); }
.dock-btn { min-width:280rpx; height:100rpx; border-radius:28rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; color:#9aa8bd; font-size:22rpx; }
.dock-icon { width:44rpx; height:44rpx; }
.dock-send { background:var(--accent); color:var(--on-accent); box-shadow:0 0 36rpx -4rpx var(--accent); }
.entry-clamp { display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden; }
