.home-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 40rpx calc(52rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.home-page .page-head { height: 56rpx; display:flex; align-items:center; gap:14rpx; }
.home-page .brand-logo { height:42rpx; width:106rpx; }
.home-page .brand-divider { width:1rpx; height:30rpx; background:#d7e2ec; margin:0 2rpx; }
.home-page .brand-product { margin-right:auto; color:#0b1f44; font-size:27rpx; font-weight:700; }
.home-main { flex:1; display:flex; flex-direction:column; justify-content:flex-start; padding-top:40rpx; }

/* 旅客留言板卡片：全宽置顶，傍晚和夜晚用深色，早晨和中午用浅色 */
.board { position:relative; min-height:352rpx; box-sizing:border-box; padding:32rpx; border-radius:24rpx; overflow:hidden; }
.board-night { color:#e7edf7; background:radial-gradient(120% 70% at 85% -20%, #24407e 0%, transparent 60%), linear-gradient(180deg, #0f1a33, #0a1120); }
.board-day { color:#0b1f44; background:radial-gradient(70% 60% at 90% -10%, #fff6d8 0%, transparent 70%), linear-gradient(180deg, #d8ebff, #eef6ff); border:1rpx solid #d7e2ec; }
.board-top { display:flex; align-items:center; justify-content:space-between; }
.board-title { display:block; font-size:32rpx; line-height:1.4; font-weight:700; }
.board-arrow { font-size:44rpx; line-height:1; color:#7cc4ff; }
.board-day .board-arrow { color:#176be8; }
.board-entries { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:24rpx; }
.board-entry { position:relative; display:flex; align-items:center; min-height:88rpx; padding:0 52rpx 0 24rpx; border-radius:20rpx; font-size:28rpx; font-weight:700; background:rgba(255,255,255,.06); border:1rpx solid rgba(255,255,255,.1); }
.board-entry-main { grid-column:span 2; border-color:rgba(124,196,255,.45); background:rgba(124,196,255,.1); }
.board-day .board-entry { background:rgba(255,255,255,.7); border-color:#d7e2ec; }
.board-day .board-entry-main { border-color:#9cc3f5; background:rgba(255,255,255,.9); }
.entry-arrow { position:absolute; right:20rpx; top:50%; transform:translateY(-55%); font-size:40rpx; font-weight:400; color:#7cc4ff; }
.board-day .entry-arrow { color:#176be8; }

/* 本次入住票卡：仅在已关联且在住时显示 */
.stay-ticket { position:relative; display:flex; height:168rpx; margin-top:24rpx; border-radius:24rpx; overflow:hidden; color:#e7edf7; background:radial-gradient(90% 120% at 100% 0%, #22407c 0%, transparent 60%), linear-gradient(180deg, #0f1a33, #0a1120); }
.ticket-stub { position:relative; flex:none; width:184rpx; display:flex; align-items:baseline; justify-content:center; padding-top:52rpx; box-sizing:border-box; border-right:3rpx dashed rgba(124,196,255,.35); }
.ticket-stub::before, .ticket-stub::after { content:''; position:absolute; right:-16rpx; width:28rpx; height:28rpx; border-radius:50%; background:#f7f9fc; }
.ticket-stub::before { top:-14rpx; }
.ticket-stub::after { bottom:-14rpx; }
.ticket-small { font-size:28rpx; font-weight:700; }
.ticket-night { margin:0 6rpx; font-size:60rpx; line-height:1; font-weight:800; text-shadow:0 0 36rpx rgba(124,196,255,.45); }
.ticket-info { flex:1; display:flex; align-items:center; justify-content:space-between; padding:0 32rpx; }
.ticket-bed { display:flex; align-items:baseline; gap:16rpx; }
.ticket-room { font-size:24rpx; color:#9aa8bd; }
.ticket-bed-no { font-size:48rpx; line-height:1; font-weight:800; text-shadow:0 0 32rpx rgba(124,196,255,.4); }
.ticket-slipper { display:flex; align-items:center; gap:12rpx; padding:10rpx 12rpx 10rpx 20rpx; border-radius:32rpx; border:1rpx solid rgba(124,196,255,.35); background:rgba(255,255,255,.05); font-size:24rpx; color:#9aa8bd; }
.ticket-slipper-no { min-width:48rpx; padding:4rpx 12rpx; border-radius:20rpx; background:#7cc4ff; color:#06101f; font-size:26rpx; font-weight:700; text-align:center; box-sizing:border-box; }

/* 服务入口：两列，文字左对齐、箭头靠右 */
.service-grid { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; margin-top:24rpx; }
.home-page .service-open { position:relative; width:100%; min-height:128rpx; margin:0; padding:0 52rpx 0 24rpx !important; background:#fff; border:1rpx solid #d7e2ec; border-radius:16rpx; display:flex !important; align-items:center !important; justify-content:flex-start !important; text-align:left !important; }
.home-page .service-open::after { border:0; }
.home-page .service-title { color:#0b1f44; font-size:29rpx; line-height:1.35; font-weight:700; text-align:left !important; }
.service-arrow { position:absolute; right:20rpx; top:50%; transform:translateY(-52%); color:#176be8; font-size:48rpx; }
.page-foot { margin-top:auto; color:#91a1b3; text-align:center; font-size:22rpx; }
.home-indicator { position:fixed; left:50%; bottom:calc(12rpx + env(safe-area-inset-bottom)); width:240rpx; height:10rpx; margin-left:-120rpx; background:#111; border-radius:12rpx; }

.draft-modal-mask { position:fixed; z-index:20; inset:0; display:flex; align-items:flex-end; background:rgba(11,31,68,.42); }
.draft-modal { width:100%; box-sizing:border-box; padding:38rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; box-shadow:0 -12rpx 48rpx rgba(11,31,68,.12); }
.draft-modal-header { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.draft-modal-heading { flex:1; min-width:0; display:flex; flex-direction:column; gap:12rpx; }
.draft-modal-title { color:#0b1f44; font-size:36rpx; line-height:1.35; font-weight:700; }
.draft-modal-intro { color:#586b80; font-size:25rpx; line-height:1.55; }
.draft-modal-close { flex:none; width:64rpx; height:64rpx; margin:-8rpx -10rpx 0 0; padding:0; border:0; background:transparent; color:#718198; font-size:48rpx; line-height:64rpx; }
.draft-modal-close::after, .draft-resume-button::after, .draft-delete-button::after, .draft-modal-later::after { border:0; }
.draft-card { margin-top:28rpx; padding:24rpx; border:1rpx solid #d7e2ec; border-radius:18rpx; background:#f8fbff; }
.draft-card-top { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; }
.draft-identity { min-width:0; display:flex; flex-direction:column; gap:10rpx; }
.draft-name { color:#0b1f44; font-size:30rpx; line-height:1.4; font-weight:700; }
.draft-meta { color:#586b80; font-size:23rpx; line-height:1.5; overflow-wrap:anywhere; }
.draft-step-badge { flex:none; max-width:180rpx; padding:8rpx 14rpx; border-radius:999rpx; background:#e9f1ff; color:#063884; font-size:21rpx; line-height:1.35; text-align:center; }
.draft-actions { display:flex; align-items:center; gap:14rpx; margin-top:22rpx; }
.draft-resume-button { flex:1; height:84rpx; margin:0; border-radius:12rpx; background:#063884; color:#fff; font-size:27rpx; line-height:84rpx; font-weight:600; }
.draft-button-arrow { margin-left:12rpx; font-size:30rpx; }
.draft-delete-button { flex:none; height:84rpx; margin:0; padding:0 24rpx; border-radius:12rpx; background:#fff; color:#586b80; border:1rpx solid #d7e2ec; font-size:25rpx; line-height:82rpx; }
.draft-modal-later { width:100%; height:76rpx; margin:18rpx 0 0; padding:0; background:transparent; color:#586b80; font-size:25rpx; line-height:76rpx; }
