<view class="gb-page" style="{{pageStyle}}">
  <text class="gb-title">{{mode === 'book' ? (editId ? t.continueBook : t.writeBook) : (editId ? t.edit : t.write)}}</text>
  <view class="editor" style="{{editorStyle}}">
    <textarea class="editor-input" value="{{content}}" maxlength="{{limit}}" auto-height placeholder="{{t.placeholder}}" placeholder-class="editor-ph" bindinput="input" />
    <text class="editor-count">{{content.length}} / {{limit}}</text>
  </view>

  <view class="photos">
    <view wx:for="{{photos}}" wx:key="src" class="photo" data-index="{{index}}" bindtap="removePhoto"><image src="{{item.src}}" mode="aspectFill" /><text class="photo-del">×</text></view>
    <view wx:if="{{photos.length < maxPhotos}}" class="photo photo-add" bindtap="choosePhoto"><text>＋</text><text class="photo-add-text">{{t.photo}}</text></view>
  </view>

  <text class="gb-label">{{t.color}}</text>
  <view class="hues">
    <view wx:for="{{colors}}" wx:key="key" class="hue {{color === item.key ? 'hue-on' : ''}}" style="border-color:{{color === item.key ? item.hue : ''}}" data-key="{{item.key}}" bindtap="pickColor"><view class="hue-dot" style="background:{{item.hue}}"></view></view>
  </view>

  <text class="gb-label">{{t.signature}}</text>
  <view class="gb-row">
    <view wx:for="{{signatures}}" wx:key="value" class="gb-chip {{signature === item.value ? 'gb-chip-on' : ''}}" data-value="{{item.value}}" bindtap="pickSignature">{{item.label}}</view>
  </view>
  <input wx:if="{{signature === 'nickname'}}" class="gb-input nickname" value="{{nickname}}" maxlength="20" placeholder="{{t.nickname}}" placeholder-class="editor-ph" bindinput="inputNickname" />

  <text class="gb-hint" wx:if="{{mode === 'book'}}">{{t.bookHint}}</text>
  <text class="gb-hint" wx:else>{{t.wallHint}}</text>

  <view class="gb-bottom"><button class="gb-primary" disabled="{{!content || submitting || (signature === 'nickname' && !nickname)}}" bindtap="submit">{{t.submit}}</button></view>
</view>
