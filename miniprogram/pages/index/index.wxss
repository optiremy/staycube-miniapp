
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.page-head {
  height: 56rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-logo {
  height: 42rpx;
  width: 106rpx;
}

.brand-divider {
  width: 1rpx;
  height: 30rpx;
  background: #d7e2ec;
  margin: 0 2rpx;
}

.brand-product {
  margin-right: auto;
  color: #0b1f44;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 58rpx;
}

.language-screen {
  padding-top: 90rpx;
}

.hero-mark {
  box-sizing: border-box;
  width: 100%;
  height: 210rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 10rpx;
}

.hero-mark-icon {
  width: 90rpx;
  height: 90rpx;
  flex: none;
  border-radius: 26rpx;
  background: #e9f1ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-mark-inner {
  width: 36rpx;
  height: 36rpx;
  border: 7rpx solid #176be8;
  border-radius: 11rpx;
  position: relative;
}

.hero-mark-inner:after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #176be8;
  border-radius: 4rpx;
  top: 5rpx;
  left: 5rpx;
}

.hero-mark-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-mark-title {
  color: #0b1f44;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-mark-en {
  color: #77889b;
  font-size: 18rpx;
  line-height: 1.4;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.eyebrow, .section-index {
  display: block;
  color: #176be8;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-suffix {
  color: #9aaaba;
  font-weight: 500;
}

.hero-title, .screen-title {
  display: block;
  margin-top: 18rpx;
  color: #0b1f44;
  font-size: 48rpx;
  line-height: 1.28;
  font-weight: 700;
  letter-spacing: -1.5rpx;
}

.hero-title-en {
  display: block;
  margin-top: 8rpx;
  color: #77889b;
  font-size: 19rpx;
  line-height: 1.4;
  font-weight: 650;
  letter-spacing: 1.2rpx;
}

.screen-title {
  font-size: 42rpx;
}

.body-copy {
  display: block;
  margin-top: 18rpx;
  color: #586b80;
  font-size: 27rpx;
  line-height: 1.65;
}

.language-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 42rpx;
}

.language-option {
  box-sizing: border-box;
  flex: 0 0 calc((100% - 16rpx) / 2);
  width: calc((100% - 16rpx) / 2);
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #d7e2ec;
  border-radius: 14rpx;
  background: #fff;
  color: #0b1f44;
  text-align: left;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 600;
}

.language-option::after, .primary-button::after, .secondary-button::after, .text-button::after {
  border: 0;
}

.language-label {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.25;
}

.option-arrow {
  color: #176be8;
  font-size: 38rpx;
  font-weight: 400;
}

.code-screen {
  padding-top: 112rpx;
}

.code-screen .screen-title {
  margin-top: 0;
  font-size: 36rpx;
  line-height: 1.4;
  letter-spacing: -.5rpx;
  white-space: pre-line;
}

.field-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 32rpx;
}

.field-label {
  color: #42566e;
  font-size: 24rpx;
  font-weight: 600;
}

.code-input, .text-input {
  box-sizing: border-box;
  height: 98rpx;
  padding: 0 26rpx;
  border: 1rpx solid #c9d5e1;
  border-radius: 12rpx;
  background: #fff;
  color: #0b1f44;
  font-size: 34rpx;
  letter-spacing: 3rpx;
}

.placeholder {
  color: #a1adba;
  font-size: 26rpx;
  letter-spacing: 0;
}

.code-field {
  margin-top: 40rpx;
}

.primary-button {
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 0 26rpx;
  margin: 32rpx 0 0;
  border-radius: 12rpx;
  background: #176be8;
  color: #fff;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  font-size: 28rpx;
  font-weight: 650;
}

.primary-button.is-button-disabled {
  opacity: .52;
}

.button-arrow {
  position: absolute;
  right: 26rpx;
  font-size: 38rpx;
  font-weight: 400;
  flex: none;
}

.button-label {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  padding: 0 48rpx;
  white-space: normal;
  overflow-wrap: anywhere;
  line-height: 1.3;
  text-align: center;
}

.code-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 28rpx;
}

.code-action-button {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 25rpx;
}

.quiet-panel {
  margin-top: 66rpx;
  padding: 26rpx 24rpx;
  background: #edf3fa;
  border-radius: 12rpx;
  color: #586b80;
  display: flex;
  gap: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.panel-accent {
  width: 5rpx;
  flex: none;
  background: #176be8;
  border-radius: 4rpx;
}

.inline-error {
  display: block;
  margin-top: 20rpx;
  color: #b23c42;
  font-size: 24rpx;
  line-height: 1.5;
}

.loading-screen, .error-screen {
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-bottom: 80rpx;
}

.loader-mark {
  width: 100rpx;
  height: 100rpx;
  border: 5rpx solid #dce8f7;
  border-top-color: #176be8;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

.status-symbol {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}

.status-warn {
  color: #a35b12;
  background: #fff1dc;
}

.text-button {
  min-height: 76rpx;
  padding: 0 20rpx;
  margin: 16rpx auto 0;
  background: transparent;
  color: #176be8;
  font-size: 25rpx;
}

.text-button.is-button-disabled {
  opacity: .48;
}

.form-screen {
  padding-top: 40rpx;
}

.form-intro {
  min-height: 28rpx;
}

.step-track {
  display: flex;
  margin: 34rpx -10rpx 34rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #dce5ed;
}

.step-track-item {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  color: #9aa8b6;
}

.step-dot {
  width: 38rpx;
  height: 38rpx;
  border: 1rpx solid #cbd6e0;
  border-radius: 50%;
  background: #f7f9fc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
}

.step-track-item.is-active {
  color: #176be8;
}

.step-track-item.is-active .step-dot {
  color: #fff;
  border-color: #176be8;
  background: #176be8;
}

.step-name {
  max-width: 100%;
  font-size: 17rpx;
  line-height: 1.3;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-content {
  display: flex;
  flex-direction: column;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #0b1f44;
  font-size: 29rpx;
  line-height: 1.4;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.section-number {
  color: #176be8;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.text-input {
  display: block;
  width: 100%;
  height: 88rpx;
  font-size: 27rpx;
  letter-spacing: 0;
}

.text-area {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: 150rpx;
  padding: 24rpx;
  border: 1rpx solid #c9d5e1;
  border-radius: 12rpx;
  background: #fff;
  color: #0b1f44;
  font-size: 27rpx;
  line-height: 1.5;
}

.rule-meta {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #73869a;
  font-size: 23rpx;
}

.rule-read-ready {
  color: #27815f;
}

.rule-paper {
  margin-top: 14rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-left: 5rpx solid #176be8;
  border-radius: 0 12rpx 12rpx 0;
  box-shadow: 0 3rpx 14rpx rgba(11,31,68,.04);
}

.rule-title {
  color: #0b1f44;
  font-size: 29rpx;
  line-height: 1.5;
  font-weight: 700;
}

.rule-body {
  margin-top: 18rpx;
  display: block;
  color: #455b72;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.rule-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.rule-actions .secondary-button {
  flex: 0 0 32%;
  min-width: 0;
}

.secondary-button {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #c9d5e1;
  border-radius: 12rpx;
  background: #fff;
  color: #25415f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
}

.secondary-button.is-button-disabled {
  color: #aab5c0;
}

.compact-button {
  min-height: 88rpx;
  flex: 1;
  min-width: 0;
  margin: 0;
}

.rule-actions .button-label {
  padding: 0 38rpx;
  font-size: 26rpx;
}

.consent-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 20rpx 0 28rpx;
  color: #344d68;
  font-size: 24rpx;
  line-height: 1.5;
}

.consent-checkbox {
  transform: scale(.86);
}

.signature-label {
  color: #42566e;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.signature-wrap {
  position: relative;
  height: 300rpx;
  border: 1rpx solid #bdcddd;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.signature-wrap.is-disabled {
  background: #f1f4f7;
  border-style: dashed;
}

.signature-canvas {
  width: 100%;
  height: 100%;
}

.signature-placeholder {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  color: #95a3b2;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
}

.signature-watermark {
  position: absolute;
  right: 20rpx;
  bottom: 15rpx;
  color: #c0cad4;
  font-size: 21rpx;
  pointer-events: none;
}

.clear-button {
  margin: 8rpx 0 0 auto;
}

.section-copy {
  margin: 4rpx 0 16rpx;
  font-size: 24rpx;
}

.qr-panel {
  margin-top: 10rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #e1e8ef;
}

.qr-title {
  color: #0b1f44;
  font-size: 25rpx;
  font-weight: 700;
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
  margin: 18rpx auto 10rpx;
}

.qr-instruction {
  color: #65798f;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.deposit-qr-panel .qr-instruction {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  text-align: left;
  font-size: 23rpx;
}

.small-code {
  margin-top: 4rpx;
  text-align: center;
  letter-spacing: 12rpx;
  font-size: 36rpx;
}

.photo-field {
  padding-top: 20rpx;
  border-top: 1rpx solid #e2e9f0;
}

.photo-preview {
  width: 100%;
  height: 260rpx;
  margin-top: 6rpx;
  border-radius: 12rpx;
  background: #edf2f7;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.photo-button {
  width: 100%;
  margin-top: 14rpx;
}

.hint-copy {
  margin-top: 16rpx;
  color: #8797a8;
  font-size: 22rpx;
  line-height: 1.55;
}

.payment-choice {
  margin: 16rpx 0 24rpx;
}

.payment-choice .primary-button {
  width: 100%;
  margin-top: 0;
}

.payment-choice .hint-copy {
  display: block;
  margin: 16rpx 0;
}

.deposit-qr-panel {
  padding: 24rpx;
}

.deposit-qr-image {
  width: 320rpx;
  height: 320rpx;
  margin: 18rpx 0 10rpx;
  border-radius: 8rpx;
}

.deposit-qr-panel .hint-copy {
  text-align: center;
}

.payment-field {
  padding-top: 24rpx;
  border-top: 1rpx solid #e2e9f0;
}

.empty-upload {
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #bccbd9;
  border-radius: 12rpx;
  color: #8a99a9;
  font-size: 23rpx;
}

.payment-preview {
  height: 320rpx;
}

.form-footer {
  position: sticky;
  bottom: 0;
  z-index: 2;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  margin-top: 18rpx;
  background: #f7f9fc;
}

.footer-back {
  width: 32%;
}

.footer-next {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  font-size: 26rpx;
}

.bottom-spacer {
  height: 20rpx;
}

.submitted-screen {
  align-items: center;
  justify-content: center;
  padding-top: 0;
  padding-bottom: 100rpx;
  text-align: center;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 40rpx;
  background: #e6f4ec;
  color: #23734f;
  font-size: 22rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2d9a68;
}

.submitted-message {
  display: block;
  max-width: 620rpx;
  margin: 34rpx auto 0;
  color: #3d5671;
  font-size: 29rpx;
  font-weight: 550;
  line-height: 1.7;
  text-align: center;
}

.submitted-notice {
  display: block;
  max-width: 580rpx;
  margin: 26rpx auto 0;
  padding-top: 22rpx;
  border-top: 1rpx solid #d7e2ec;
  color: #8999ab;
  font-size: 23rpx;
  line-height: 1.7;
  text-align: center;
}

.submitted-edit-panel {
  width: 100%;
  margin-top: 34rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #d7e2ec;
  border-radius: 20rpx;
  background: #fff;
  text-align: left;
}

.submitted-edit-panel .section-heading {
  margin-bottom: 10rpx;
}

.submitted-edit-panel .hint-copy {
  display: block;
  margin-bottom: 18rpx;
}

.keep-together {
  white-space: nowrap;
}

.small-copy {
  font-size: 23rpx;
}

.page-foot {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 2rpx;
  color: #97a4b1;
  font-size: 19rpx;
}

.photo-processing-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}


.phone-row { display:flex; gap:14rpx; align-items:center; }
.country-code { box-sizing:border-box; display:flex; align-items:center; gap:10rpx; height:88rpx; padding:0 22rpx; border:1rpx solid #c9d5e1; border-radius:12rpx; background:#fff; color:#0b1f44; font-size:27rpx; font-weight:600; }
.country-code-arrow { color:#176be8; font-size:18rpx; }
.phone-number-input { flex:1; min-width:0; }
.phone-hint { margin-top:10rpx; }

.document-type-title { display:block; margin-bottom:28rpx; color:#0b1f44; font-size:38rpx; line-height:1.35; font-weight:700; }
.document-choice { display:flex; align-items:center; gap:24rpx; margin-bottom:20rpx; padding:26rpx 24rpx; border:1rpx solid #d7e2ec; border-radius:18rpx; background:#fff; }
.document-choice.is-selected { border-color:#176be8; background:#f2f7ff; }
.document-icon { position:relative; flex:none; width:88rpx; height:88rpx; border-radius:24rpx; background:#eef3f8; display:flex; align-items:center; justify-content:center; }
.document-choice.is-selected .document-icon { background:#e3edff; }
.document-icon-image { width:52rpx; height:52rpx; }
.document-check { position:absolute; right:-10rpx; bottom:-10rpx; width:36rpx; height:36rpx; box-sizing:border-box; border:4rpx solid #f2f7ff; border-radius:50%; background:#176be8; color:#fff; font-size:20rpx; line-height:28rpx; text-align:center; }
.document-choice-label { flex:1; min-width:0; color:#0b1f44; font-size:30rpx; line-height:1.4; font-weight:700; }
