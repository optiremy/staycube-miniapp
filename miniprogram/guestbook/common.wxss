/* 留言板公共样式。页面色值由 guestbook-theme.pageStyle 写入 CSS 变量。 */
.gb-page { min-height:100vh; box-sizing:border-box; padding:24rpx 40rpx calc(180rpx + env(safe-area-inset-bottom)); font-family:-apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.gb-head { padding-top:8rpx; }
.gb-eyebrow { font-size:24rpx; color:var(--sub); letter-spacing:4rpx; }
.gb-title { display:block; margin-top:12rpx; font-size:52rpx; line-height:1.3; font-weight:700; }
.gb-sub { display:block; margin-top:8rpx; font-size:26rpx; line-height:1.6; color:var(--sub); }
.gb-card { padding:28rpx; border-radius:32rpx; border:1rpx solid var(--line); background:var(--card); }
.gb-row { display:flex; gap:16rpx; flex-wrap:wrap; }
.gb-chip { padding:14rpx 24rpx; border-radius:30rpx; border:1rpx solid var(--line); background:var(--card); font-size:26rpx; color:var(--sub); }
.gb-chip-on { border-color:var(--accent); color:var(--text); }
.gb-seg { display:flex; padding:6rpx; border-radius:20rpx; background:var(--accent-soft); font-size:26rpx; }
.gb-seg-item { flex:1; padding:12rpx 0; border-radius:16rpx; text-align:center; color:var(--sub); }
.gb-seg-on { background:var(--card); color:var(--text); font-weight:600; }
.gb-label { display:block; margin:40rpx 0 18rpx; font-size:24rpx; letter-spacing:2rpx; color:var(--faint); }
.gb-hint { display:block; margin-top:32rpx; font-size:24rpx; line-height:1.6; color:var(--faint); }
.gb-bottom { position:fixed; left:0; right:0; bottom:0; padding:28rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); }
.gb-primary { width:100% !important; height:100rpx; margin:0; border-radius:50rpx; background:var(--accent); color:var(--on-accent); font-size:32rpx; font-weight:600; line-height:100rpx; }
.gb-primary::after, .gb-plain::after { border:0; }
.gb-plain { display:block; width:auto !important; margin-top:20rpx; padding:0 !important; background:none !important; color:var(--sub); font-size:26rpx; font-weight:400; line-height:1.6; }

.note { position:relative; margin-bottom:20rpx; padding:30rpx 28rpx 24rpx; border-radius:32rpx; border:1rpx solid transparent; font-size:28rpx; line-height:1.65; }
.note-text { display:block; color:var(--text); white-space:pre-line; }
.note-foot { display:flex; justify-content:space-between; align-items:center; margin-top:24rpx; font-size:22rpx; color:var(--faint); }
.note-count { display:flex; align-items:center; gap:8rpx; font-family:"SF Mono", Menlo, monospace; font-weight:600; }
.note-dot { width:14rpx; height:14rpx; border-radius:50%; }
