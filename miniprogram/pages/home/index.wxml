<view class="page home-page">
  <view class="page-head">
    <image class="brand-logo" src="/assets/sifang-blue.png" mode="heightFix" />
    <text class="brand-divider"></text>
    <text class="brand-product">stayCube</text>
    <language-switcher id="lang-switcher" locale="{{locale}}" bindchange="changeLocale" />
  </view>

  <view class="home-main">
    <view wx:if="{{guestbook.state === 'guest'}}" class="board board-{{guestbook.tone}}" data-page="index" bindtap="openGuestbook">
      <view class="board-top"><text class="board-title">{{copy.board.title}}</text><text class="board-arrow">›</text></view>
    </view>
    <view wx:else class="board board-{{guestbook.tone}}">
      <text class="board-title">{{copy.board.title}}</text>
      <view class="board-entries">
        <view class="board-entry board-entry-main" data-page="index" bindtap="openGuestbook"><text>{{copy.board.wall}}</text><text class="entry-arrow">›</text></view>
        <view wx:if="{{guestbook.state === 'staying'}}" class="board-entry" data-page="book" bindtap="openGuestbook"><text>{{copy.board.book}}</text><text class="entry-arrow">›</text></view>
        <view class="board-entry {{guestbook.state === 'staying' ? '' : 'board-entry-main'}}" data-page="mine" bindtap="openGuestbook"><text>{{copy.board.mine}}</text><text class="entry-arrow">›</text></view>
      </view>
    </view>

    <view wx:if="{{guestbook.state === 'staying'}}" class="stay-ticket">
      <view class="ticket-stub"><text class="ticket-small">{{guestbook.nightParts[0]}}</text><text class="ticket-night">{{guestbook.nights}}</text><text class="ticket-small">{{guestbook.nightParts[1]}}</text></view>
      <view class="ticket-info">
        <view class="ticket-bed"><text class="ticket-room">{{guestbook.roomLabel}}</text><text class="ticket-bed-no">{{guestbook.bed}}</text></view>
        <view wx:if="{{guestbook.slipper}}" class="ticket-slipper"><text>{{copy.board.slipper}}</text><text class="ticket-slipper-no">{{guestbook.slipper}}</text></view>
      </view>
    </view>

    <view class="service-grid">
      <button wx:for="{{services}}" wx:key="key" class="service-open" data-path="{{item.path}}" bindtap="openService">
        <text class="service-title">{{item.title}}</text>
        <text class="service-arrow">›</text>
      </button>
    </view>
  </view>

  <view wx:if="{{draftModalVisible}}" class="draft-modal-mask" catchtap="closeDraftModal">
    <view class="draft-modal" catchtap="stopDraftModal">
      <view class="draft-modal-header">
        <view class="draft-modal-heading">
          <text class="draft-modal-title">{{copy.draft.title}}</text>
          <text class="draft-modal-intro">{{copy.draft.intro}}</text>
        </view>
        <button class="draft-modal-close" aria-label="{{copy.draft.later}}" bindtap="closeDraftModal">×</button>
      </view>
      <view wx:for="{{drafts}}" wx:key="recordId" class="draft-card">
          <view class="draft-card-top">
            <view class="draft-identity">
              <text class="draft-name">{{item.guestName}}</text>
              <text class="draft-meta">{{copy.draft.checkinDate}}{{item.checkinDateLabel}}</text>
              <text class="draft-meta">{{copy.draft.accessCode}}{{item.accessCode}}　{{copy.draft.lastUpdated}}{{item.lastUpdatedLabel}}</text>
            </view>
            <text class="draft-step-badge">{{item.stepLabel}}</text>
          </view>
          <view class="draft-actions">
            <button class="draft-resume-button" data-id="{{item.recordId}}" bindtap="resumeDraft">{{copy.draft.resume}}<text class="draft-button-arrow">→</text></button>
            <button class="draft-delete-button" data-id="{{item.recordId}}" bindtap="deleteDraft">{{copy.draft.remove}}</button>
          </view>
      </view>
      <button class="draft-modal-later" bindtap="closeDraftModal">{{copy.draft.later}}</button>
    </view>
  </view>

  <view class="page-foot">Powered by stayCube</view>
</view>
