<view class="gb-page done" style="{{pageStyle}}">
  <view class="stage">
    <view class="ghosts"><view></view><view class="slot" style="{{noteStyle}}"><text class="slot-text">{{text}}</text></view><view></view><view></view><view></view><view></view></view>
    <view class="fly"><view class="note" style="{{noteStyle}}"><text class="note-text">{{text}}</text></view></view>
  </view>
  <view class="after">
    <text class="done-title">{{t.submitted}}</text>
    <text class="gb-sub">{{showsIn}}</text>
  </view>
  <text class="done-back" bindtap="back">{{backText}} ›</text>
</view>
