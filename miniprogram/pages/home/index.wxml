<view class="page home-page" style="{{pageStyle}}">
  <view class="page-head">
    <image class="brand-logo {{dark ? 'brand-logo-light' : ''}}" src="/assets/sifang-blue.png" mode="heightFix" />
    <view class="head-spacer"></view>
    <language-switcher id="lang-switcher" locale="{{locale}}" bindchange="changeLocale" />
  </view>

  <view class="home-main">
    <view wx:if="{{ticket}}" class="stay-ticket">
      <view class="ticket-stub"><text class="ticket-small">{{ticket.nightParts[0]}}</text><text class="ticket-night">{{ticket.nights}}</text><text class="ticket-small">{{ticket.nightParts[1]}}</text></view>
      <view class="ticket-info">
        <text class="ticket-bed-no">{{ticket.bedLabel}}</text>
        <view wx:if="{{ticket.slipper}}" class="ticket-slipper"><text>{{copy.ticket.slipper}}</text><text class="ticket-slipper-no">{{ticket.slipper}}</text></view>
      </view>
    </view>

    <view class="home-card">
      <text class="card-title">{{copy.home.title}}</text>
      <view class="service-list">
        <button wx:for="{{services}}" wx:key="key" class="service-open" data-path="{{item.path}}" bindtap="openService">
          <image class="service-icon" src="/assets/home-icons/{{item.key}}-{{tone}}.svg" />
          <text class="service-title">{{item.title}}</text>
          <text class="service-arrow">›</text>
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{draftModalVisible}}" class="draft-modal-mask" catchtap="closeDraftModal">
    <view class="draft-modal" catchtap="stopDraftModal">
      <view class="draft-modal-header">
        <view class="draft-modal-heading">
          <text class="draft-modal-title">{{copy.draft.title}}</text>
          <text class="draft-modal-intro">{{copy.draft.intro}}</text>
        </view>
        <button class="draft-modal-close" aria-label="{{copy.draft.later}}" bindtap="closeDraftModal">×</button>
      </view>
      <view wx:for="{{drafts}}" wx:key="recordId" class="draft-card">
          <view class="draft-card-top">
            <view class="draft-identity">
              <text class="draft-name">{{item.guestName}}</text>
              <text class="draft-meta">{{copy.draft.checkinDate}}{{item.checkinDateLabel}}</text>
              <text class="draft-meta">{{copy.draft.accessCode}}{{item.accessCode}}　{{copy.draft.lastUpdated}}{{item.lastUpdatedLabel}}</text>
            </view>
            <text class="draft-step-badge">{{item.stepLabel}}</text>
          </view>
          <view class="draft-actions">
            <button class="draft-resume-button" data-id="{{item.recordId}}" bindtap="resumeDraft">{{copy.draft.resume}}<text class="draft-button-arrow">→</text></button>
            <button class="draft-delete-button" data-id="{{item.recordId}}" bindtap="deleteDraft">{{copy.draft.remove}}</button>
          </view>
      </view>
      <button class="draft-modal-later" bindtap="closeDraftModal">{{copy.draft.later}}</button>
    </view>
  </view>

  <view class="page-foot">Powered by stayCube</view>
</view>
