@import "../common.wxss";

.head { padding-top:36rpx; }
.head-room { display:block; font-size:48rpx; font-weight:700; color:var(--text); }
.head-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:16rpx; }

.banner { margin-top:28rpx; padding:20rpx 24rpx; border-radius:16rpx; font-size:26rpx; line-height:1.55; }
.banner.rej { background:var(--red-soft); color:var(--red); }
.banner.wait { background:var(--amber-soft); color:var(--amber); }

.sec { display:flex; margin-top:44rpx; font-size:26rpx; font-weight:700; color:var(--sub); }
.sec-count { margin-left:auto; font-weight:400; color:var(--faint); }

.list { margin-top:16rpx; border:1rpx solid var(--line); border-radius:18rpx; background:var(--field); overflow:hidden; }
.item { display:flex; align-items:center; min-height:96rpx; padding:20rpx 28rpx; box-sizing:border-box; border-top:1rpx solid var(--line); font-size:30rpx; color:var(--text); }
.item:first-child { border-top:0; }
.box { flex:none; width:44rpx; height:44rpx; margin-right:24rpx; border-radius:10rpx; border:3rpx solid var(--field-line); box-sizing:border-box; display:flex; align-items:center; justify-content:center; font-size:26rpx; color:#fff; }
.item.on .box { background:var(--accent); border-color:var(--accent); }
.item.on .item-name { color:var(--sub); }
.item-right { margin-left:auto; padding-left:16rpx; font-size:28rpx; color:var(--sub); }
.locked .box { background:var(--fill); }
.locked .item.on .box { background:#9fb6d8; border-color:#9fb6d8; }

.photos { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; margin-top:16rpx; }
.shot { position:relative; padding:20rpx; border:2rpx dashed var(--field-line); border-radius:18rpx; background:var(--field); }
.shot.done { border-style:solid; border-color:var(--line); }
.shot-img, .shot-empty { display:block; width:100%; height:192rpx; border-radius:12rpx; }
.shot-empty { display:flex; align-items:center; justify-content:center; background:var(--fill); color:var(--accent); font-size:26rpx; font-weight:600; }
.shot-redo { position:absolute; right:32rpx; top:156rpx; padding:4rpx 12rpx; border-radius:8rpx; background:rgba(0,0,0,.35); color:#fff; font-size:22rpx; }
.shot-cap { display:block; margin-top:16rpx; font-size:24rpx; line-height:1.45; color:var(--sub); }
