@import "../common.wxss";
.hit { display:inline-block; margin-top:24rpx; padding:10rpx 20rpx; border-radius:24rpx; background:var(--accent-soft); color:var(--accent); font-size:24rpx; }
.agree { display:flex; gap:16rpx; align-items:flex-start; margin-top:48rpx; font-size:24rpx; line-height:1.6; color:var(--sub); }
.agree-box { flex:none; width:32rpx; height:32rpx; margin-top:4rpx; border-radius:50%; border:2rpx solid var(--accent); box-sizing:border-box; }
.agree-on { background:var(--accent); box-shadow:inset 0 0 0 6rpx var(--card); }
