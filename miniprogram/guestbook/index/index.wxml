<view class="gb-root" style="{{pageStyle}}">
  <movable-area wx:if="{{view === 'wall' && loaded}}" class="area">
    <movable-view class="canvas" direction="{{pannable ? 'all' : 'none'}}" inertia="true" friction="1" out-of-bounds="true" damping="30" x="{{canvas.x}}" y="{{canvas.y}}" style="width:{{canvas.width}}px;height:{{canvas.height}}px">
      <view class="grid" style="grid-template-columns:repeat({{cols}}, 300rpx)">
        <view wx:for="{{tiles}}" wx:key="id" class="tile {{item.photoUrl ? 'tile-photo' : ''}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="openNote">
          <image wx:if="{{item.photoUrl}}" class="tile-img" src="{{item.photoUrl}}" mode="aspectFill" />
          <text wx:else class="tile-text">{{item.content}}</text>
        </view>
      </view>
    </movable-view>
  </movable-area>

  <scroll-view wx:else scroll-y class="timeline">
    <view class="entries">
      <view wx:for="{{entries}}" wx:key="id" class="entry">
        <view class="entry-dot" style="background:{{item.hue}};box-shadow:0 0 16rpx {{item.hue}}"></view>
        <view class="entry-when"><text class="entry-date">{{item.date}}</text><text wx:if="{{item.status !== 'approved'}}" class="entry-mine">{{t.pending}}</text><text class="entry-by">{{item.author}}</text></view>
        <view class="entry-box" data-index="{{index}}" bindtap="openEntry"><text class="note-text entry-clamp">{{item.content}}</text>
          <view wx:if="{{item.photoList.length}}" class="entry-pics"><image wx:for="{{item.photoList}}" wx:for-item="p" wx:key="*this" class="entry-pic" src="{{p}}" mode="aspectFill" data-src="{{p}}" data-list="{{item.photoList}}" catchtap="previewPhoto" /></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{canPublish}}" class="dock">
    <view class="dock-btn dock-send" bindtap="publish">
      <image class="dock-icon" src="/guestbook/icons/send.svg" />
      <text>{{t.publish}}</text>
    </view>
  </view>
</view>
