@import "../common.wxss";
.entries { position:relative; margin-top:36rpx; padding-left:36rpx; }
.entries::before { content:''; position:absolute; left:8rpx; top:12rpx; bottom:12rpx; width:1rpx; background:var(--line); }
.entry { position:relative; margin-bottom:36rpx; }
.entry-dot { position:absolute; left:-36rpx; top:12rpx; width:18rpx; height:18rpx; border-radius:50%; }
.entry-when { display:flex; align-items:center; font-size:24rpx; color:var(--sub); }
.entry-date { font-weight:600; color:var(--text); }
.entry-mine { margin-left:12rpx; padding:2rpx 12rpx; border-radius:16rpx; background:var(--accent); color:var(--on-accent); font-size:20rpx; }
.entry-by { margin-left:auto; }
.entry-box { margin-top:16rpx; padding:28rpx; border-radius:28rpx; border:1rpx solid var(--line); background:var(--card); font-size:28rpx; line-height:1.75; }
.entry-pics { display:flex; gap:12rpx; margin-top:20rpx; }
.entry-pic { flex:1; height:140rpx; border-radius:16rpx; background:var(--accent-soft); }
